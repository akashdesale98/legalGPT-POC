# Indian Legal GPT — Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.

# --- LLM Provider ---
LLM_PROVIDER=ollama          # ollama | claude | gemini
OLLAMA_URL=http://localhost:11434
CLAUDE_API_KEY=               # Required if LLM_PROVIDER=claude
GEMINI_API_KEY=               # Required if LLM_PROVIDER=gemini

# --- Models ---
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2
VECTOR_SIZE=768

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=               # Required for Qdrant Cloud

# --- PostgreSQL ---
DATABASE_URL=                 # e.g., postgres://user:pass@localhost:5432/legalgpt?sslmode=disable

# --- Redis ---
REDIS_URL=localhost:6379

# --- API ---
API_PORT=8080
DEFAULT_COLLECTION=constitution
DEFAULT_TOP_K=5

# --- Auth ---
DEV_TOKEN=                    # Static dev token for local testing; WARNING logged on every use

# --- Observability ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=  # e.g., localhost:4317
