# LegalGPT Query Service — environment variable template
# Copy to .env for local dev (never commit .env)

# Service
API_PORT=8080
DEV_MODE=false
DEV_TOKEN=

# LLM Provider: ollama | claude | gemini | router
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
CLAUDE_API_KEY=
GEMINI_API_KEY=

# Routing (only when LLM_PROVIDER=router)
LLM_ROUTE_THRESHOLD=500

# Embedding
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2
VECTOR_SIZE=768

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=

# PostgreSQL
POSTGRES_DSN=postgres://postgres:password@localhost:5432/legalgpt?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT (RS256)
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_PRIVATE_KEY_PATH=keys/private.pem

# Worker pool
WORKER_POOL_SIZE=50

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
